<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LoopLauncher.App"
             StartupUri="MainWindow.axaml">
    
    <Application.Styles>
        <FluentTheme /> <StyleInclude Source="avares://LoopLauncher/Styles/Colors.axaml" />
        <FluentTheme /> <StyleInclude Source="avares://LoopLauncher/Styles/Controls.axaml" />
    </Application.Styles>
</Application>